{
  "name": "@workspace/auth",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./password": "./src/password.ts",
    "./organization": "./src/organization.ts",
    "./roles": "./src/roles.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --",
    "generate": "pnpm with-env auth generate --config ./src/index.ts --output ../db/src/schema/auth.ts --yes"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.18",
    "@t3-oss/env-core": "^0.13.11",
    "@workspace/db": "workspace:*",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "auth": "^1.7.18",
    "dotenv-cli": "^11.1.0",
    "typescript": "^5"
  }
}
