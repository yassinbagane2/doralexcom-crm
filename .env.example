POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doralexcom
DATABASE_SSL=false
BETTER_AUTH_SECRET=
# Production only, when the web app and API live on sibling subdomains
# (app.example.com + api.example.com): set to example.com.
AUTH_COOKIE_DOMAIN=

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# Hostname businesses CNAME their own web address to: the machine running
# deploy/Caddyfile. Defaults to NEXT_PUBLIC_APP_URL's hostname.
CUSTOM_DOMAIN_TARGET=

RESEND_API_KEY=
EMAIL_FROM="Doralexcom <onboarding@resend.dev>"

# Cloudflare R2, where customer documents are stored. The API token needs
# Object Read & Write on both buckets; its id and value derive the S3 keys.
S3_INPUT_BUCKET=
S3_OUTPUT_BUCKET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_API_TOKEN_ID=
