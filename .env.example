# Read by every app and package through `dotenv -e ../../.env` in their scripts.

# --- Database ---------------------------------------------------------------
# Matches docker-compose.yml. Start it with `docker compose up -d`.
# POSTGRES_PORT is the host port Docker publishes; keep it in sync with the URL.
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tube
# Set to true for managed Postgres that requires TLS (Neon, RDS, Supabase…).
DATABASE_SSL=false

# --- Auth -------------------------------------------------------------------
# At least 32 characters. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Production only, when the web app and API live on sibling subdomains
# (app.example.com + api.example.com): set to example.com.
AUTH_COOKIE_DOMAIN=

# --- URLs -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3001

# --- Email ------------------------------------------------------------------
# Leave empty in development: codes are printed to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Tube <onboarding@resend.dev>"
