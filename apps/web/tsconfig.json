{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@workspace/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "jsx": "preserve"
  },
  "include": [
    "next-env.d.ts",
    "next.config.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  // Next generates this file with unused imports when the app has no route
  // handlers, which trips noUnusedLocals. `next build` validates exports anyway.
  "exclude": [
    "node_modules",
    ".next/types/validator.ts",
    ".next/dev/types/validator.ts"
  ]
}
